APP_ENV=development
API_PORT=18080
WEB_PORT=18081
HTTP_ADDR=:18080
MAX_UPLOAD_BYTES=104857600
JWT_SECRET=replace-this-with-at-least-32-random-characters
JWT_KID=v1
# Development-only key. Generate a unique 32-byte base64 key for every real deployment.
TOTP_ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
COOKIE_SECURE=false
PUBLIC_BASE_URL=http://localhost:18081
TRUSTED_PROXY_CIDRS=172.16.0.0/12
POSTGRES_PORT=15432
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
PROMETHEUS_PORT=19090
GRAFANA_PORT=13000
MAILPIT_UI_PORT=18025
DATABASE_URL=postgres://cloudlet:cloudlet@postgres:5432/cloudlet?sslmode=disable
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:19000
S3_CORS_ORIGIN=http://localhost:18081
S3_REGION=us-east-1
S3_BUCKET=cloudlet
S3_ACCESS_KEY=cloudlet
S3_SECRET_KEY=cloudlet-secret
S3_USE_PATH_STYLE=true
PDFTOPPM_PATH=pdftoppm
CLAMAV_ADDRESS=clamav:3310
CLAMAV_SCAN_TIMEOUT=2m
CLAMAV_STREAM_MAX_LENGTH=110M
SMTP_ADDRESS=mailpit:1025
SMTP_HOST=mailpit
SMTP_FROM=no-reply@cloudlet.local
SMTP_REQUIRE_TLS=false
