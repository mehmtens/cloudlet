APP_ENV=production
HTTP_ADDR=:18080
CLOUDLET_SITE_ADDRESS=cloudlet.example.com
MAX_UPLOAD_BYTES=104857600
JWT_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_KID=v1
TOTP_ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY
COOKIE_SECURE=true
PUBLIC_BASE_URL=https://cloud.example.com
# Only the private network range used by the reverse proxy; never use 0.0.0.0/0.
TRUSTED_PROXY_CIDRS=172.16.0.0/12

DATABASE_URL=postgres://USER:PASSWORD@POSTGRES_HOST:5432/cloudlet?sslmode=require
# Single-VM Oracle deployment only: use a URL-safe random POSTGRES_PASSWORD and
# DATABASE_URL=postgres://cloudlet:PASSWORD@postgres:5432/cloudlet?sslmode=disable
POSTGRES_USER=cloudlet
POSTGRES_PASSWORD=GENERATE_A_RANDOM_URL_SAFE_PASSWORD
POSTGRES_DB=cloudlet

S3_ENDPOINT=https://YOUR_S3_OR_R2_ENDPOINT
S3_PUBLIC_ENDPOINT=https://YOUR_PUBLIC_S3_OR_R2_ENDPOINT
S3_CORS_ORIGIN=https://cloudlet.example.com
S3_REGION=auto
S3_BUCKET=cloudlet
S3_ACCESS_KEY=REPLACE_ME
S3_SECRET_KEY=REPLACE_ME
S3_USE_PATH_STYLE=true
# AES256 (SSE-S3) or aws:kms. Leave S3_KMS_KEY_ID blank for the provider default KMS key.
S3_SERVER_SIDE_ENCRYPTION=AES256
S3_KMS_KEY_ID=

# Use a real SMTP provider on its STARTTLS port (commonly 587).
SMTP_ADDRESS=smtp.provider.example:587
SMTP_HOST=smtp.provider.example
SMTP_USERNAME=REPLACE_ME
SMTP_PASSWORD=REPLACE_ME
SMTP_FROM=no-reply@your-verified-domain.example
SMTP_REQUIRE_TLS=true

# A reachable clamd service. All file, version, and multipart uploads fail closed if it is unavailable.
CLAMAV_ADDRESS=clamav:3310
CLAMAV_SCAN_TIMEOUT=2m
# Must be greater than MAX_UPLOAD_BYTES when using the bundled ClamAV image.
CLAMAV_STREAM_MAX_LENGTH=110M

PDFTOPPM_PATH=pdftoppm
